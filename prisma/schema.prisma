generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MERCHANT
}

enum MerchantStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum KycStatus {
  PENDING
  SUBMITTED
  VERIFIED
  REJECTED
}

enum PaymentStatus {
  CREATED
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  UPI
  CARD
  NETBANKING
  WALLET
}

enum RefundStatus {
  CREATED
  PENDING
  PROCESSING
  SUCCESS
  FAILED
}

enum PayoutStatus {
  CREATED
  PENDING
  PROCESSING
  SUCCESS
  FAILED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(MERCHANT)

  merchant     Merchant?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Merchant {
  id           String         @id @default(cuid())
  userId       String         @unique

  businessName String
  businessType String
  phone        String

  status       MerchantStatus @default(PENDING)

  user         User           @relation(fields: [userId], references: [id])

  kyc          Kyc?
  payments     Payment[]
  refunds      Refund[]
  payouts      Payout[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Kyc {
  id                String     @id @default(cuid())
  merchantId        String     @unique

  provider          String     @default("MOCK_KYC")
  providerReference String?
  referenceId       String?
  status            KycStatus  @default(PENDING)
  submittedAt       DateTime?
  verifiedAt        DateTime?
  rejectedAt        DateTime?
  rejectionReason   String?

  merchant          Merchant   @relation(fields: [merchantId], references: [id])

  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
}

model Payment {
  id                String        @id @default(cuid())

  merchantId        String

  orderId           String        @unique
  providerOrderId   String?
  provider          String?
  providerPaymentId String?
  cashfreeOrderId   String?
  paymentSessionId  String?

  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @default("INR")

  paymentMethod     PaymentMethod
  description       String?
  metadata          Json?

  status            PaymentStatus @default(CREATED)
  paidAt            DateTime?

  merchant          Merchant      @relation(fields: [merchantId], references: [id])

  refunds           Refund[]
  webhookEvents     WebhookEvent[]

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([merchantId, orderId])
  @@index([merchantId])
  @@index([status])
}

model Refund {
  id                String        @id @default(cuid())

  paymentId         String
  merchantId        String

  provider          String?
  providerRefundId  String?

  amount            Decimal       @db.Decimal(12, 2)
  reason            String?
  metadata          Json?

  status            RefundStatus  @default(CREATED)
  processedAt       DateTime?

  payment           Payment       @relation(fields: [paymentId], references: [id])
  merchant          Merchant      @relation(fields: [merchantId], references: [id])

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([paymentId])
}

model Payout {
  id             String        @id @default(cuid())

  merchantId     String

  beneficiaryId  String
  amount         Decimal       @db.Decimal(12, 2)
  currency       String        @default("INR")

  provider       String?
  providerPayoutId String?
  metadata       Json?

  status         PayoutStatus  @default(CREATED)
  processedAt    DateTime?

  merchant       Merchant      @relation(fields: [merchantId], references: [id])

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model WebhookEvent {
  id          String   @id @default(cuid())

  eventId     String   @unique
  eventType   String
  paymentId   String?
  provider    String
  payload     Json
  signature   String?
  status      String   @default("RECEIVED")
  processedAt DateTime?

  payment     Payment? @relation(fields: [paymentId], references: [id])
  processed   Boolean  @default(false)

  createdAt   DateTime @default(now())
}

model IdempotencyKey {
  id          String   @id @default(cuid())

  key         String
  merchantId  String
  endpoint    String

  response    Json?

  createdAt   DateTime @default(now())

  @@unique([key, merchantId, endpoint])
}